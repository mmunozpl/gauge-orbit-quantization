# proceso local, no versionado (convención del árbol: solo
# README/LEEME + código se comitean)
SPEC_*.md
notas_*.md
*.local.md
configs/*.local.yaml
/nota/
# del paper viaja el PDF y no el fuente: el tag congela lo que
# se deposita, y lo que se deposita es el PDF (convencion de la
# casa, igual que en el trabajo previo).
/paper/*
!/paper/*.pdf
ESTADO_ACTUAL.md
RESUMEN_REVISION.md
reanudar.md

# artefactos pesados / generados: el csv crudo del barrido se
# queda fuera (7,6 MB); las tablas de lectura en frío y las figuras
# SÍ se versionan (nota corta, dataset pequeño, trazabilidad directa).
/artifacts/logs/
/artifacts_*/
# el portador de la demo son 258 mb de pesos extraidos; lo
# reconstruye scripts/extraer_sector_vo.py y viaja al Space por
# scripts/desplegar_demo.py, no por git.
/artifacts/demo/
__pycache__/
*.pyc
.pytest_cache/

# LaTeX build (si se añade la nota .tex en este repo)
*.aux
*.log
*.out
*.fls
*.fdb_latexmk
*.synctex.gz

# entorno local (pyproject.toml + uv.lock SÍ se versionan, para
# fijar las versiones exactas del barrido)
.venv/
